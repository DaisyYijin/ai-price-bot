# ================= AI 大模型（OpenAI 兼容，默认 DeepSeek） =================
# DeepSeek:  https://platform.deepseek.com  申请 API Key
# 换其他厂商只需改 BASE_URL / MODEL，例如智谱 GLM:
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4.7
# 注意：Docker 部署时推荐直接在 http://服务器:8000/admin 网页后台填写本文件的全部内容
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ================= 企业微信（自建应用） =================
# 管理后台 https://work.weixin.qq.com → 应用管理 → 自建应用
# 回调 URL 填: http(s)://你的公网域名:8000/webhook/wecom
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ================= 钉钉（企业内部应用 · Stream 模式，无需公网IP） =================
# 开放平台 https://open-dev.dingtalk.com → 应用开发 → 机器人，开启 Stream 模式
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ================= QQ 官方机器人（无需公网IP） =================
# 开放平台 https://q.qq.com 创建机器人（个人可注册），获取 AppID 与 Secret
QQ_ENABLED=false
QQ_APP_ID=
QQ_CLIENT_SECRET=

# ================= 比价数据源 =================
# 逗号分隔；当前内置: meituan,taobao,jd,douyin（模拟数据）
PRICE_PROVIDERS=meituan,taobao,jd,douyin

# 会话保留轮数（每轮 = 一问一答）
HISTORY_ROUNDS=10
